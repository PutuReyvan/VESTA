# Copy to `.env`. Keep populated `.env` uncommitted.

# Sepolia deployment. Never expose the private key.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
DEMO_TOKEN_MINT_AMOUNT=1000000

# On-chain addresses.
VESTA_TOKEN_ADDRESS=
VESTA_MANAGER_ADDRESS=
VESTA_RPC_URL=

# Browser-safe Vite variables.
VITE_CHAIN_ID=11155111
VITE_CONTRACT_ADDRESS=
VITE_TOKEN_ADDRESS=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase server/CLI values. Never expose service-role keys to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
